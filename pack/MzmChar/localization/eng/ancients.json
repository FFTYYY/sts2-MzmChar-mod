{
  "_README_": "Mutsumi ↔ Ancients dialogue. Key: <ANCIENT>.talk.MZMCHAR-MUTSUMI_CHARACTER.<dialogueIdx>-<lineIdx>.<speaker>",
  "_README_speakers": ".ancient = ancient speaks | .char = character (Mutsumi) speaks | NOT .character",
  "_README_attack": "Architect-only: <ANCIENT>.talk.MZMCHAR-MUTSUMI_CHARACTER.<dialogueIdx>-attack = None|Player|Architect|Both",
  "_README_indices": "Dialogue index from 0, must be contiguous. Line index from 0. Append r for repeating (e.g. 0-0r.ancient); all lines within one dialogue must share r-or-not.",
  "_README_visits": "Optional: <dialogueIdx>-visit = N overrides VisitIndex for that dialogue (default mapping in BaseLib AncientDialogueUtil).",
  "_README_design": "Per ancient: dialogue 0 = first visit (charVisits=0); dialogue 1+ with r = re-visit. Architect uses pool roll: multiple r dialogues all with -visit:1 → rolled randomly from charVisits>=1.",

  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.0-0.ancient": "...Another climber.",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.0-1.char":    "...mm.",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.0-2.ancient": "What are you here for?",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.0-3.char":    "...just looking.",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.0-4.ancient": "Get out, mortal.",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.0-attack":    "Architect",

  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.1-0r.ancient": "...why are you back.",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.1-1r.char":    "...forgot something.",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.1-2r.ancient": "What did you forget?",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.1-3r.char":    "...forgot.",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.1-visit":      "1",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.1-attack":     "Architect",

  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.2-0r.ancient": "You stand here again.",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.2-1r.char":    "...took a wrong turn.",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.2-2r.ancient": "...every time?",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.2-3r.char":    "...yes.",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.2-visit":      "1",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.2-attack":     "Architect",

  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.3-0r.ancient": "You're back.",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.3-1r.char":    "...didn't really want to be.",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.3-2r.ancient": "Then let's get this over with.",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.3-visit":      "1",
  "THE_ARCHITECT.talk.MZMCHAR-MUTSUMI_CHARACTER.3-attack":     "Architect",

  "DARV.talk.MZMCHAR-MUTSUMI_CHARACTER.0-0.ancient": "You're... haven't I seen you before?",
  "DARV.talk.MZMCHAR-MUTSUMI_CHARACTER.0-1.char":    "...first time.",
  "DARV.talk.MZMCHAR-MUTSUMI_CHARACTER.0-2.ancient": "Mm. I'll note it down.",
  "DARV.talk.MZMCHAR-MUTSUMI_CHARACTER.1-0r.ancient": "You're... haven't I seen you before?",
  "DARV.talk.MZMCHAR-MUTSUMI_CHARACTER.1-1r.char":    "...yes.",
  "DARV.talk.MZMCHAR-MUTSUMI_CHARACTER.1-2r.ancient": "Mm. I'll note it down again.",

  "NEOW.talk.MZMCHAR-MUTSUMI_CHARACTER.0-0.ancient": "I have... remade you... go... up...",
  "NEOW.talk.MZMCHAR-MUTSUMI_CHARACTER.0-1.char":    "...you didn't remake me.",
  "NEOW.talk.MZMCHAR-MUTSUMI_CHARACTER.0-2.ancient": "...I did. Forgot.",
  "NEOW.talk.MZMCHAR-MUTSUMI_CHARACTER.1-0r.ancient": "I've... remade you again...?",
  "NEOW.talk.MZMCHAR-MUTSUMI_CHARACTER.1-1r.char":    "...I walked here myself.",

  "NONUPEIPE.talk.MZMCHAR-MUTSUMI_CHARACTER.0-0.ancient": "...finally, someone.",
  "NONUPEIPE.talk.MZMCHAR-MUTSUMI_CHARACTER.0-1.char":    "...mm.",
  "NONUPEIPE.talk.MZMCHAR-MUTSUMI_CHARACTER.0-2.ancient": "You don't have to leave.",
  "NONUPEIPE.talk.MZMCHAR-MUTSUMI_CHARACTER.0-3.char":    "...I have to.",
  "NONUPEIPE.talk.MZMCHAR-MUTSUMI_CHARACTER.1-0r.ancient": "...you left. You came back.",
  "NONUPEIPE.talk.MZMCHAR-MUTSUMI_CHARACTER.1-1r.char":    "...just passing through.",

  "OROBAS.talk.MZMCHAR-MUTSUMI_CHARACTER.0-0.ancient": "Guest! Guest!! All the way up here!",
  "OROBAS.talk.MZMCHAR-MUTSUMI_CHARACTER.0-1.char":    "...just kind of walked here.",
  "OROBAS.talk.MZMCHAR-MUTSUMI_CHARACTER.0-2.ancient": "Walked here! Walked here!!",
  "OROBAS.talk.MZMCHAR-MUTSUMI_CHARACTER.1-0r.ancient": "Guest! Walked here again!!",
  "OROBAS.talk.MZMCHAR-MUTSUMI_CHARACTER.1-1r.char":    "...used to it.",

  "PAEL.talk.MZMCHAR-MUTSUMI_CHARACTER.0-0.ancient": "Can you go check on Father for me?",
  "PAEL.talk.MZMCHAR-MUTSUMI_CHARACTER.0-1.char":    "...where is your father?",
  "PAEL.talk.MZMCHAR-MUTSUMI_CHARACTER.0-2.ancient": "...I don't know either.",
  "PAEL.talk.MZMCHAR-MUTSUMI_CHARACTER.1-0r.ancient": "...did you find Father?",
  "PAEL.talk.MZMCHAR-MUTSUMI_CHARACTER.1-1r.char":    "...I don't even know what he looks like.",

  "TANX.talk.MZMCHAR-MUTSUMI_CHARACTER.0-0.ancient": "Climber! You can do it!",
  "TANX.talk.MZMCHAR-MUTSUMI_CHARACTER.0-1.char":    "...do what?",
  "TANX.talk.MZMCHAR-MUTSUMI_CHARACTER.0-2.ancient": "...anything!",
  "TANX.talk.MZMCHAR-MUTSUMI_CHARACTER.1-0r.ancient": "You did it again!!",
  "TANX.talk.MZMCHAR-MUTSUMI_CHARACTER.1-1r.char":    "...haven't started yet.",

  "TEZCATARA.talk.MZMCHAR-MUTSUMI_CHARACTER.0-0.ancient": "Oh, a visitor! Do come in, dear!",
  "TEZCATARA.talk.MZMCHAR-MUTSUMI_CHARACTER.0-1.char":    "...there's no door out here.",
  "TEZCATARA.talk.MZMCHAR-MUTSUMI_CHARACTER.0-2.ancient": "There will be once you come in.",
  "TEZCATARA.talk.MZMCHAR-MUTSUMI_CHARACTER.1-0r.ancient": "Dear, you're back! Come in!",
  "TEZCATARA.talk.MZMCHAR-MUTSUMI_CHARACTER.1-1r.char":    "...I never left.",

  "VAKUU.talk.MZMCHAR-MUTSUMI_CHARACTER.0-0.ancient": "Want power? I can show you what no one sees.",
  "VAKUU.talk.MZMCHAR-MUTSUMI_CHARACTER.0-1.char":    "...what I can see is enough.",
  "VAKUU.talk.MZMCHAR-MUTSUMI_CHARACTER.0-2.ancient": "...fine.",
  "VAKUU.talk.MZMCHAR-MUTSUMI_CHARACTER.1-0r.ancient": "Changed your mind?",
  "VAKUU.talk.MZMCHAR-MUTSUMI_CHARACTER.1-1r.char":    "...still no thanks."
}
