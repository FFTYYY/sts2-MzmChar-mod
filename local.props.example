<?xml version="1.0" encoding="utf-8"?>
<!--
  把这个文件复制为 local.props，填好你本机的路径。
  local.props 已在 .gitignore 中，不会被提交。

  PowerShell:  Copy-Item local.props.example local.props
  Bash:        cp local.props.example local.props
-->
<Project>
  <PropertyGroup>
    <!-- Slay the Spire 2 安装目录（包含 sts2.dll 和 mods/ 的那一级） -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</GameDir>

    <!-- MegaDot 可执行文件**完整路径**（注意是 .exe 不是目录）。
         推荐用 *_console.exe 版本，headless 跑能拿到 stdout。 -->
    <MegaDotExe>C:\path\to\MegaDot_v4.5.1-stable_mono_win64_console.exe</MegaDotExe>

    <!-- 构建后是否自动复制到游戏 mods 目录。默认 true。 -->
    <AutoDeploy>true</AutoDeploy>
  </PropertyGroup>
</Project>
