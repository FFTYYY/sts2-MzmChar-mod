<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- 所有子项目共用的设置 -->

  <!-- 自动导入 local.props（如果存在） -->
  <Import Project="$(MSBuildThisFileDirectory)local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)local.props')" />

  <PropertyGroup>
    <ModId>MzmChar</ModId>
    <ModVersion>0.2.7</ModVersion>

    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- 默认启用自动部署，可在 local.props 中关掉 -->
    <AutoDeploy Condition="'$(AutoDeploy)' == ''">true</AutoDeploy>
  </PropertyGroup>

  <!--
    BETA define 自动检测（已废弃 / dormant，2026-07-03 起 v0.107 vs v0.108 走**运行时反射派发**）：

    v0.108 beta 加了 CardPlay 参到 AttackCommand.FromCard / Hook.ModifyDamage / CreatureCmd.Damage /
    AbstractModel.ModifyDamageMultiplicative。历史上用 #if BETA 编译期分双路，需要发两份 dll。

    改用运行时派发后：一份 dll 通吃 v0.107 stable + v0.108 beta。
       - cmd 分歧：Sts2Compat 静态 ctor 探测 Hook.ModifyDamage 参数数 → 设 IsBeta bool
         → 3 个 wrapper (FromCardCompat / ModifyDamageCompat / CreatureDamage) 用 MethodInfo.Invoke 分派
       - override 分歧（HalfDamagePower.ModifyDamageMultiplicative）：改成 Harmony patch
         on AbstractModel.ModifyDamageMultiplicative，Harmony 按参数名匹配跨版本

    因此 _IsBetaDll 触发字符串关到 v0.999 = dormant 状态，`dotnet build -c Beta` 也不再需要。
    保留骨架防未来 vanilla 破坏严重到只能编译期分路（如某个基础类型改名 / 删除）时可以快速开门。

    完整状态记录：notes/api_version_gating.md
  -->
  <PropertyGroup Condition="'$(Configuration)' != 'Beta' And Exists('$(GameDir)\release_info.json')">
    <_ReleaseInfoText>$([System.IO.File]::ReadAllText('$(GameDir)\release_info.json'))</_ReleaseInfoText>
    <_IsBetaDll Condition="$(_ReleaseInfoText.Contains('v0.999'))">true</_IsBetaDll>
    <DefineConstants Condition="'$(_IsBetaDll)' == 'true'">$(DefineConstants);BETA</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Beta'">
    <DefineConstants>$(DefineConstants);BETA</DefineConstants>
  </PropertyGroup>
</Project>
